htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.pytest_cache/

# Jupyter Notebook
.ipynb_checkpoints

# pyenv
.python-version

# pipenv
Pipfile.lock

# mypy
.mypy_cache/
.dmypy.json

# VS Code
.vscode/

# Model outputs and data
*.joblib
*.xlsx
output/
BU_Model_2025/output/
ML model/*.png
ML model/*.csv

# Artifact directories (model outputs, figures, metrics).  The compact,
# reviewer-facing reproducibility tables are versioned evidence; model binaries
# and general exploratory artifacts remain ignored.
artifacts/*
!artifacts/.gitkeep
!artifacts/repro/
artifacts/repro/*
!artifacts/repro/metrics_zi.json
!artifacts/repro/kjasem_26_0013/
artifacts/repro/kjasem_26_0013/*
!artifacts/repro/kjasem_26_0013/*.json
!artifacts/repro/kjasem_26_0013/*.csv
!artifacts/repro/kjasem_26_0013/*.csv.gz
!artifacts/repro/kjasem_26_0013/*.md

# Core dumps (should never be checked in — see commit 0166ff2)
core
core.*

# Large binary outputs
*.nc
*.h5
*.hdf5

# System files
.DS_Store
Thumbs.db
